{
  "expo": {
    "name": "MEMORYGAME",
    "slug": "memorygame",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "memorygame",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B1020",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1020"
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
